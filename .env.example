# Copy to .env (chmod 600) for local dev. In prod this is /etc/trendstealer/env
# referenced via systemd EnvironmentFile=.

# --- Mode switches (see docs, all default to the safe/offline value) ---
TRENDSTEALER_APIFY_MODE=fixture      # fixture | live
TRENDSTEALER_LLM_BACKEND=fixture     # fixture | anthropic
TRENDSTEALER_PUBLISH_MODE=dry_run    # dry_run | live

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Apify ---
APIFY_API_TOKEN=

# --- Instagram Graph API (per-brand: IG_ACCESS_TOKEN__ACME overrides this) ---
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
FB_APP_ID=
FB_APP_SECRET=

# --- Review dashboard ---
REVIEW_DASHBOARD_TOKEN=
REVIEW_DASHBOARD_HOST=127.0.0.1
REVIEW_DASHBOARD_PORT=5000
FLASK_SECRET_KEY=

# --- Fallback upload path (only used if resumable Graph upload is unavailable) ---
UPLOAD_HOST_BASE_URL=
UPLOAD_HOST_ACCESS_KEY=
UPLOAD_HOST_SECRET_KEY=

# --- Paths (defaults are relative to repo root, override in prod) ---
TRENDSTEALER_DB_PATH=var/db/trendstealer.db
TRENDSTEALER_VAR_DIR=var
