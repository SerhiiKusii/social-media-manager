# Copy to .env (chmod 600) for local dev. In prod this is /etc/trendstealer/env
# referenced via systemd EnvironmentFile=.

# Keep every comment on its own line: systemd's EnvironmentFile= does not
# strip trailing `# ...` from a value, so an inline comment silently becomes
# part of the setting (python-dotenv does strip it, which is exactly why the
# breakage only shows up once a unit runs).

# --- Mode switches (see docs, all default to the safe/offline value) ---
# TRENDSTEALER_APIFY_MODE: fixture | live
TRENDSTEALER_APIFY_MODE=fixture
# TRENDSTEALER_LLM_BACKEND: fixture | anthropic
TRENDSTEALER_LLM_BACKEND=fixture
# TRENDSTEALER_PUBLISH_MODE: dry_run | live
TRENDSTEALER_PUBLISH_MODE=dry_run

# --- Which brand the systemd units operate on ---
BRAND_KEY=acme

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Apify ---
APIFY_API_TOKEN=

# --- Pexels (free stock B-roll: https://www.pexels.com/api/) ---
# The pipeline never republishes scraped video, so on-screen footage comes
# from here (or your own files). The Pexels licence allows commercial use.
PEXELS_API_KEY=

# --- Instagram Graph API (per-brand: IG_ACCESS_TOKEN__ACME overrides this) ---
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
FB_APP_ID=
FB_APP_SECRET=

# Tokens from the "Instagram Login" app flow (IGAA... prefix) only work
# against graph.instagram.com and have no resumable-upload endpoint --
# uncomment both for that flow; leave unset for classic Facebook-Login
# Page-linked tokens (graph.facebook.com, resumable upload supported).
# TRENDSTEALER_GRAPH_API_BASE=https://graph.instagram.com/v21.0
# TRENDSTEALER_PUBLISH_TUNNEL=cloudflared

# --- Review dashboard ---
REVIEW_DASHBOARD_TOKEN=
REVIEW_DASHBOARD_HOST=127.0.0.1
REVIEW_DASHBOARD_PORT=5000
FLASK_SECRET_KEY=

# --- Fallback upload path (only used if resumable Graph upload is unavailable) ---
UPLOAD_HOST_BASE_URL=
UPLOAD_HOST_ACCESS_KEY=
UPLOAD_HOST_SECRET_KEY=

# --- Paths (defaults are relative to repo root, override in prod) ---
TRENDSTEALER_DB_PATH=var/db/trendstealer.db
TRENDSTEALER_VAR_DIR=var
